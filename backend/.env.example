# ── Database (Neon) ────────────────────────────────────────────────
# Copy the "Pooled connection" string from the Neon dashboard.
# It must include ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/tpm?sslmode=require"

# For running migrations, Neon recommends a DIRECT (non-pooled) URL.
# If you only have one URL, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/tpm?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────────
# Generate a long random secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ── Server ─────────────────────────────────────────────────────────
PORT="4000"
NODE_ENV="development"

# Comma-separated list of allowed browser origins (your Netlify site + local dev).
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,https://transformationpm.netlify.app"

# ── Registration invite codes (seeded into the InviteCode table) ───
# Used only by prisma/seed.js to create the initial codes.
SEED_LEADER_CODE="TPM-LEADER-2026"
SEED_ADMIN_CODE="TPM-ADMIN-2026"

# Optional: create a first admin account on seed so you can log in immediately.
SEED_ADMIN_EMAIL="admin@tpministries.org"
SEED_ADMIN_PASSWORD="ChangeMe123!"
