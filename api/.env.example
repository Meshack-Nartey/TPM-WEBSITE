# Copy to .env and fill in. Nothing here has a default — the app refuses to
# start without DATABASE_URL and JWT_SECRET, which is intended.

# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=jdbc:postgresql://ep-xxx-pooler.eu-central-1.aws.neon.tech/tpm?sslmode=require

# Direct connection, no pooler. Used by Flyway: migrations take locks that a
# connection pooler mishandles.
DIRECT_DATABASE_URL=jdbc:postgresql://ep-xxx.eu-central-1.aws.neon.tech/tpm?sslmode=require

DATABASE_USER=tpm
DATABASE_PASSWORD=

# At least 32 bytes: openssl rand -base64 48
JWT_SECRET=

# How long an access token lives (ISO-8601 duration).
JWT_EXPIRY=PT12H

# Browser origins for the website. The Flutter app is not a browser origin and
# needs no entry here.
CORS_ORIGINS=https://transformationpm.netlify.app,http://localhost:8888

LOG_LEVEL=INFO
